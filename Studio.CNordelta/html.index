html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Studio C Nordelta — Alta Moda & Showroom VIP en Nordelta, Tigre. Vestidos de fiesta, lentejuelas, tul y abrigos de lujo. Reservá tu Cita VIP.">
  <meta property="og:title" content="Studio C Nordelta — Alta Moda & Cita VIP">
  <meta property="og:description" content="La experiencia de compra más exclusiva de la zona norte. Vestidos de gala, cóctel y abrigos premium.">
  <title>Studio C · Nordelta — Alta Moda & Showroom VIP</title>
  <link rel="stylesheet" href="styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>

<!-- ═══════════════════════════════════════════
     CUSTOM CURSOR
════════════════════════════════════════════ -->
<div class="cursor-dot" id="cursor-dot"></div>
<div class="cursor-ring" id="cursor-ring"></div>

<!-- ═══════════════════════════════════════════
     NAVBAR
════════════════════════════════════════════ -->
<nav id="navbar">
  <a href="#hero" class="nav-logo">Studio <span>C</span></a>

  <ul class="nav-links">
    <li><a href="#catalogo">Colección</a></li>
    <li><a href="#about">Nosotros</a></li>
    <li><a href="#reserva">Cita VIP</a></li>
    <li><a href="#contacto">Contacto</a></li>
  </ul>

  <div class="nav-actions">
    <button class="nav-cart-btn" aria-label="Carrito de compras">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <span>Carrito</span>
      <span class="cart-badge" id="cart-badge">0</span>
    </button>
    <button class="nav-hamburger" aria-label="Menú">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- ═══════════════════════════════════════════
     HERO
════════════════════════════════════════════ -->
<section id="hero">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-grain"></div>

  <div class="hero-content">
    <div class="hero-eyebrow">
      <span class="gold-line"></span>
      <span class="label">Nordelta · Tigre · Buenos Aires</span>
    </div>
    <h1 class="hero-title">
      Alta Moda<br>
      <em>sin límites.</em>
    </h1>
    <p class="hero-sub">
      Vestidos de gala, lentejuelas y abrigos premium para mujeres que
      eligen brillar. Showroom privado con atención VIP personalizada.
    </p>
    <div class="hero-actions">
      <a href="#catalogo" class="btn-primary">
        <span>Ver Colección</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="#reserva" class="btn-solid">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
        </svg>
        <span>Reservar Cita VIP</span>
      </a>
    </div>
  </div>

  <div class="hero-scroll">
    <div class="scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     MARQUEE STRIP
════════════════════════════════════════════ -->
<div class="marquee-strip" aria-hidden="true">
  <div class="marquee-inner">
    <span>Alta Moda Nordelta</span>
    <span>Vestidos de Gala</span>
    <span>Showroom Privado</span>
    <span>10% Off Transferencia</span>
    <span>Lentejuelas & Tul Premium</span>
    <span>Cita VIP</span>
    <span>Zona Norte</span>
    <span>Faux Fur Collection</span>
    <span>Diseño Exclusivo</span>
    <span>Alta Moda Nordelta</span>
    <span>Vestidos de Gala</span>
    <span>Showroom Privado</span>
    <span>10% Off Transferencia</span>
    <span>Lentejuelas & Tul Premium</span>
    <span>Cita VIP</span>
    <span>Zona Norte</span>
    <span>Faux Fur Collection</span>
    <span>Diseño Exclusivo</span>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     ABOUT
════════════════════════════════════════════ -->
<section id="about">
  <div class="about-img-wrap reveal">
    <img
      src="https://images.pexels.com/photos/16688527/pexels-photo-16688527.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=1200&w=800"
      alt="Studio C Nordelta Showroom"
      loading="lazy"
    >
    <div class="about-img-border"></div>
  </div>
  <div class="about-text">
    <span class="label reveal"><span class="gold-line"></span>Nuestra Historia</span>
    <h2 class="reveal reveal-delay-1">Un espacio creado para <em>la mujer que elige brillar.</em></h2>
    <p class="reveal reveal-delay-2">
      Studio C nació en el corazón de Nordelta con una misión clara: democratizar
      el acceso a la alta moda sin sacrificar exclusividad. Cada pieza de nuestra
      colección está seleccionada con ojo editorial y pasión por el detalle.
    </p>
    <p class="reveal reveal-delay-3">
      Nuestro showroom privado es más que una tienda: es una experiencia sensorial
      donde el tiempo se detiene y tú eres la protagonista. Atención personalizada,
      asesoramiento de imagen y flexibilidad total en tallas y colores.
    </p>
    <div class="about-stats reveal reveal-delay-4">
      <div class="stat-item">
        <div class="num count-up" data-target="500" data-suffix="+">0+</div>
        <div class="desc">Clientas felices</div>
      </div>
      <div class="stat-item">
        <div class="num count-up" data-target="5" data-suffix=" años">0 años</div>
        <div class="desc">De trayectoria</div>
      </div>
      <div class="stat-item">
        <div class="num count-up" data-target="12" data-suffix="">0</div>
        <div class="desc">Piezas en colección</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     CATÁLOGO / SHOP
════════════════════════════════════════════ -->
<section id="catalogo">
  <div class="section-header reveal">
    <div class="section-title-block">
      <span class="label"><span class="gold-line"></span>Colección Actual</span>
      <h2>Nuestra <em>Selección</em></h2>
    </div>
    <a href="#reserva" class="btn-primary">
      <span>Ver en Showroom</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Transfer Banner -->
  <div class="transfer-banner reveal">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 6v4l3 3"/>
    </svg>
    <p>
      <strong>10% de descuento</strong> en todos los productos pagando por transferencia bancaria.
      Los precios con descuento se muestran en <strong>dorado</strong>.
      Consultá disponibilidad de talles y colores por WhatsApp.
    </p>
  </div>

  <!-- Filter Bar -->
  <div class="filter-bar reveal">
    <button class="filter-btn active" data-filter="todos">Todos</button>
    <button class="filter-btn" data-filter="largos">Vestidos Largos</button>
    <button class="filter-btn" data-filter="cortos">Vestidos Cortos</button>
    <button class="filter-btn" data-filter="abrigos">Abrigos</button>
  </div>

  <!-- Products Grid -->
  <div id="products-grid" class="products-grid"></div>
</section>

<!-- ═══════════════════════════════════════════
     EXPERIENCIA STRIP
════════════════════════════════════════════ -->
<div style="background: var(--surface); padding: 80px 60px; border-top: 1px solid rgba(201,169,110,0.1); border-bottom: 1px solid rgba(201,169,110,0.1);">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; max-width: 1200px; margin: 0 auto;">
    <div class="reveal" style="text-align: center; padding: 32px 24px;">
      <div style="color: var(--gold); margin-bottom: 20px;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <h4 style="font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: var(--white); margin-bottom: 10px;">Atención Personalizada</h4>
      <p style="font-size: 0.8rem; color: var(--text-sub); line-height: 1.8;">Asesoramiento exclusivo en showroom privado con cita previa.</p>
    </div>
    <div class="reveal reveal-delay-1" style="text-align: center; padding: 32px 24px;">
      <div style="color: var(--gold); margin-bottom: 20px;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <rect x="1" y="4" width="22" height="16" rx="2"/><path d="M1 10h22"/>
        </svg>
      </div>
      <h4 style="font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: var(--white); margin-bottom: 10px;">10% OFF Transferencia</h4>
      <p style="font-size: 0.8rem; color: var(--text-sub); line-height: 1.8;">Descuento inmediato pagando por transferencia bancaria.</p>
    </div>
    <div class="reveal reveal-delay-2" style="text-align: center; padding: 32px 24px;">
      <div style="color: var(--gold); margin-bottom: 20px;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
      </div>
      <h4 style="font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: var(--white); margin-bottom: 10px;">Nordelta, Tigre</h4>
      <p style="font-size: 0.8rem; color: var(--text-sub); line-height: 1.8;">Showroom ubicado en Nordelta. Coordinar visita por WhatsApp.</p>
    </div>
    <div class="reveal reveal-delay-3" style="text-align: center; padding: 32px 24px;">
      <div style="color: var(--gold); margin-bottom: 20px;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
        </svg>
      </div>
      <h4 style="font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: var(--white); margin-bottom: 10px;">Colección Renovada</h4>
      <p style="font-size: 0.8rem; color: var(--text-sub); line-height: 1.8;">Nuevos ingresos cada temporada. Siempre lo último en moda de gala.</p>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════
     RESERVA CITA VIP
════════════════════════════════════════════ -->
<section id="reserva">
  <div class="section-header reveal">
    <div class="section-title-block">
      <span class="label"><span class="gold-line"></span>Experiencia Exclusiva</span>
      <h2>Reservá tu <em>Cita VIP</em></h2>
    </div>
  </div>

  <div class="booking-wrap">
    <!-- Left: Image & Perks -->
    <div class="booking-left">
      <img
        src="https://images.pexels.com/photos/8311878/pexels-photo-8311878.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=800&w=600"
        alt="Showroom Studio C Nordelta"
        loading="lazy"
        class="reveal"
      >
      <div class="booking-perks reveal reveal-delay-1">
        <div class="perk-item">
          <div class="perk-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div class="perk-text">
            <p>Atención 100% exclusiva</p>
            <small>El showroom es solo para vos durante tu cita</small>
          </div>
        </div>
        <div class="perk-item">
          <div class="perk-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="perk-text">
            <p>Asesoramiento de imagen</p>
            <small>Te ayudamos a encontrar el look perfecto para tu evento</small>
          </div>
        </div>
        <div class="perk-item">
          <div class="perk-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <div class="perk-text">
            <p>Cita de 60-90 minutos</p>
            <small>Sin apuros, con champagne y experiencia premium</small>
          </div>
        </div>
        <div class="perk-item">
          <div class="perk-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <div class="perk-text">
            <p>Reserva de piezas</p>
            <small>Guardamos tu selección hasta el evento</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Form -->
    <div>
      <form id="booking-form" class="booking-form reveal">
        <p style="font-size: 0.82rem; color: var(--text-sub); line-height: 1.8; margin-bottom: 8px;">
          Completá el formulario y te contactaremos para confirmar tu cita VIP en nuestro showroom de Nordelta.
          También podés escribirnos directamente al WhatsApp.
        </p>

        <div class="form-row">
          <div class="form-group">
            <label for="name">Nombre completo</label>
            <input type="text" id="name" name="name" placeholder="Tu nombre" required>
          </div>
          <div class="form-group">
            <label for="phone">Teléfono / WhatsApp</label>
            <input type="tel" id="phone" name="phone" placeholder="+54 11 ..." required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="date">Fecha preferida</label>
            <input type="date" id="date" name="date" required>
          </div>
          <div class="form-group">
            <label for="time">Horario preferido</label>
            <select id="time" name="time" required>
              <option value="" disabled selected>Seleccioná un horario</option>
              <option value="10:00hs">10:00 hs</option>
              <option value="11:00hs">11:00 hs</option>
              <option value="12:00hs">12:00 hs</option>
              <option value="14:00hs">14:00 hs</option>
              <option value="15:00hs">15:00 hs</option>
              <option value="16:00hs">16:00 hs</option>
              <option value="17:00hs">17:00 hs</option>
              <option value="18:00hs">18:00 hs</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="occasion">Tipo de evento</label>
          <select id="occasion" name="occasion" required>
            <option value="" disabled selected>¿Para qué ocasión?</option>
            <option value="Casamiento">Casamiento / Boda</option>
            <option value="Cumpleaños 15">Cumpleaños de 15</option>
            <option value="Gala / Premiación">Gala / Premiación</option>
            <option value="Cóctel / Cocktail">Cóctel / Cocktail</option>
            <option value="Graduación">Graduación</option>
            <option value="Cumpleaños adultos">Cumpleaños adultos</option>
            <option value="Fiesta Empresarial">Fiesta Empresarial</option>
            <option value="Otro">Otro</option>
          </select>
        </div>

        <div class="form-group">
          <label for="notes">Notas adicionales (opcional)</label>
          <textarea id="notes" name="notes" placeholder="Talle aproximado, color preferido, referencias de estilo..."></textarea>
        </div>

        <button type="submit" class="btn-solid" style="width: 100%; justify-content: center; padding: 18px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          <span>Solicitar Cita por WhatsApp</span>
        </button>
      </form>

      <!-- Success State -->
      <div id="booking-success" class="form-success">
        <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <h3>¡Solicitud enviada!</h3>
        <p>Te redirigimos a WhatsApp para confirmar tu Cita VIP.<br>Te esperamos en nuestro showroom de Nordelta.</p>
        <button class="btn-primary" onclick="location.reload()" style="margin-top: 8px;">
          <span>Volver al inicio</span>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     CART DRAWER
════════════════════════════════════════════ -->
<div class="cart-overlay" id="cart-overlay"></div>

<aside id="cart-drawer" role="dialog" aria-label="Carrito de compras">
  <div class="cart-header">
    <div>
      <span class="label">Tu Selección</span>
      <h3>Carrito</h3>
    </div>
    <button class="cart-close" aria-label="Cerrar carrito">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="cart-body" id="cart-body">
    <div class="cart-empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <p>Tu carrito está vacío.<br>Explorá nuestra colección.</p>
    </div>
  </div>

  <div class="cart-footer" id="cart-footer" style="display: none;">
    <div class="cart-subtotals">
      <div class="cart-row">
        <span>Subtotal</span>
        <strong class="subtotal-val">$0</strong>
      </div>
      <div class="cart-row total-row" style="padding-top: 12px; border-top: 1px solid rgba(201,169,110,0.1);">
        <span>Total con transferencia</span>
        <strong class="total-val">$0</strong>
      </div>
    </div>
    <div class="cart-transfer-note">
      <strong>10% de descuento</strong> ya aplicado en todos los precios mostrados.
      Enviá tu pedido por WhatsApp para coordinar el pago.
    </div>
    <button class="cart-wa-btn" aria-label="Finalizar pedido por WhatsApp">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
